# Port (Railway sets this automatically, fallback 3001)
# PORT=3001

# Public URL for QR page links (set to your Railway URL)
# BRIDGE_PUBLIC_URL=https://your-bridge-name.up.railway.app

# CORS origin (allow frontend domain)
# CORS_ORIGIN=https://your-frontend.vercel.app

# Puppeteer executable path (Railway: set to "chromium" or the full path)
# PUPPETEER_EXECUTABLE_PATH=chromium

# Google Sheets URL for queue backup (optional)
# CHARLIE_SHEETS_URL=https://script.google.com/macros/s/your-script-id/exec
