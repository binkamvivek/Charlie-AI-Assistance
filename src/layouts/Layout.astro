---
import '../styles/global.css';

interface Props {
	title?: string;
}

const { title = "Charlie AI Assistant - Autonomous Personal AI Workspace" } = Astro.props;
---

<!doctype html>
<html lang="en" class="dark">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content="Charlie AI Assistant - A full-screen dark-mode bento grid AI assistant powered by React, Web Speech API, Google Sheets memory, and local OS automation bridge." />
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Geist+Mono:wght@400;500;600&family=Geist:wght@400;500;600;700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
		<title>{title}</title>
	</head>
	<body class="bg-[#090a0f] text-slate-100 antialiased selection:bg-sky-500 selection:text-slate-950">
		<slot />
	</body>
</html>
